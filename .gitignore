# ===== LARAVEL GITIGNORE =====

# Env - JANGAN PERNAH DI-PUSH (berisi password, API key, dll)
.env
.env.*
!.env.example

# Vendor - diinstall ulang via composer install
/vendor/

# Node modules
/node_modules/

# Storage (upload files, cache, logs - tidak perlu di-push)
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Build files
/public/build/
/public/hot

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.idea/
.vscode/
*.swp
*.swo
.phpunit.result.cache

# Composer lock bisa di-push, tapi ini optional
# composer.lock

# NPM
package-lock.json
yarn.lock
